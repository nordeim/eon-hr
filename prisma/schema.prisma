// Eon HR — Prisma schema (SQLite)
// Money is stored as integer minor units (halalas, 1 SAR = 100) — floats never
// touch money (scandihaven PAD §money rule, adapted). Dates are stored as
// DateTime (SQLite stores ISO strings; Prisma normalizes at the boundary).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================ Core / Auth

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("employee") // admin | hr | manager | security | employee
  avatarUrl    String?
  phone        String?
  jobTitle     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee         Employee?
  leaveRequests    LeaveRequest[]          @relation("LeaveRequestApprover")
  staffRequests    StaffRequest[]
  expenseClaims    ExpenseClaim[]
  posts            Post[]
  announcements    Announcement[]
  notifications    Notification[]
  sentMessages     Message[]               @relation("MessageSender")
  aiChats          AIChat[]
  notificationPref NotificationPreference?
  auditLogs        AuditLog[]
  goalTargets      Goal[]                  @relation("GoalCreator")
}

model Company {
  id                 String   @id @default(cuid())
  name               String   @default("Demo")
  industry           String?
  size               String?
  phone              String?
  email              String?
  website            String?
  address            String?
  taxId              String?
  registrationNumber String?
  updatedAt          DateTime @updatedAt
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  code      String?
  headId    String?
  employees Employee[]
  createdAt DateTime   @default(now())
}

// ============================================================ Employees

model Employee {
  id               String    @id @default(cuid())
  employeeId       String    @unique
  userId           String?   @unique
  firstName        String
  lastName         String
  email            String    @unique
  privateEmail     String?
  phone            String?
  jobTitle         String?
  departmentId     String?
  managerId        String?
  employmentStatus String    @default("active") // active | on_leave | suspended | terminated
  employmentType   String    @default("full_time") // full_time | part_time | contract | intern
  startDate        DateTime?
  endDate          DateTime?
  baseSalary       Int       @default(0) // minor units (halalas)
  nationality      String?
  nationalId       String?
  dateOfBirth      DateTime?
  gender           String?
  // Saudi-specific identity fields (reference Add Employee wizard, step 1)
  iqamaNumber      String?
  iqamaExpiry      DateTime?
  // Contract fields (wizard step 3)
  contractType     String? // indefinite | fixed_term
  contractStart    DateTime?
  bankName         String?
  iban             String?
  gosiNumber       String?
  address          String?
  avatarUrl        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user              User?                @relation(fields: [userId], references: [id])
  department        Department?          @relation(fields: [departmentId], references: [id])
  manager           Employee?            @relation("OrgChart", fields: [managerId], references: [id])
  reports           Employee[]           @relation("OrgChart")
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  attendanceRecords AttendanceRecord[]
  shiftAssignments  ShiftAssignment[]
  documents         Document[]
  payrollRecords    PayrollRecord[]
  loans             Loan[]
  expenseClaims     ExpenseClaim[]
  onboardingProcs   OnboardingProcess[]
  offboardingProcs  OffboardingProcess[]
  complianceAlerts  ComplianceAlert[]
  letterRequests    HRLetter[]
  goals             Goal[]
  reviews           Review[]
  reviewsGiven      Review[]             @relation("Reviewer")
  evaluations       Evaluation[]
  assets            Asset[]
  surveyResponses   SurveyResponse[]
}

// ============================================================ Leave

model LeaveType {
  id        String         @id @default(cuid())
  name      String         @unique
  quotaDays Int            @default(0)
  color     String         @default("#3b82f6")
  balances  LeaveBalance[]
  requests  LeaveRequest[]
}

model LeaveBalance {
  id          String @id @default(cuid())
  employeeId  String
  leaveTypeId String
  year        Int
  entitled    Int    @default(0)
  used        Int    @default(0)

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id          String    @id @default(cuid())
  employeeId  String
  leaveTypeId String
  startDate   DateTime
  endDate     DateTime
  days        Int
  reason      String?
  status      String    @default("pending") // pending | approved | rejected | cancelled
  approverId  String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  approver  User?     @relation("LeaveRequestApprover", fields: [approverId], references: [id])
}

// ============================================================ Attendance / Shifts

model AttendanceRecord {
  id          String    @id @default(cuid())
  employeeId  String
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  status      String    @default("present") // present | absent | late | leave
  minutesLate Int       @default(0)
  overtime    Int       @default(0) // minutes
  notes       String?
  createdAt   DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

model Shift {
  id           String            @id @default(cuid())
  name         String
  startTime    String // "09:00"
  endTime      String // "17:00"
  departmentId String?
  active       Boolean           @default(true)
  assignments  ShiftAssignment[]
}

model ShiftAssignment {
  id         String   @id @default(cuid())
  employeeId String
  shiftId    String
  date       DateTime
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift    @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, date])
}

// ============================================================ Documents

model Document {
  id         String    @id @default(cuid())
  employeeId String
  name       String
  type       String    @default("other") // contract | id | passport | visa | certificate | medical | other
  fileUrl    String?
  issueDate  DateTime?
  expiryDate DateTime?
  status     String    @default("valid") // valid | expiring | expired | pending_upload
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ============================================================ Payroll

model PayrollRecord {
  id          String    @id @default(cuid())
  employeeId  String
  period      String // "2026-10"
  basicSalary Int       @default(0)
  allowances  Int       @default(0)
  bonus       Int       @default(0)
  deductions  Int       @default(0)
  netSalary   Int       @default(0)
  status      String    @default("draft") // draft | approved | paid
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, period])
}

model Loan {
  id                String    @id @default(cuid())
  employeeId        String
  amount            Int // principal, minor units
  reason            String?
  installmentMonths Int       @default(12)
  monthlyDeduction  Int       @default(0)
  remaining         Int       @default(0)
  status            String    @default("pending") // pending | approved | active | rejected | completed
  requestedAt       DateTime  @default(now())
  decidedAt         DateTime?
  updatedAt         DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model ExpenseClaim {
  id          String    @id @default(cuid())
  employeeId  String
  userId      String?
  title       String
  category    String    @default("other") // travel | meals | equipment | training | medical | other
  amount      Int // minor units
  description String?
  receiptUrl  String?
  date        DateTime  @default(now())
  status      String    @default("pending") // pending | approved | rejected | reimbursed
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])
}

// ============================================================ Recruitment

model JobPosting {
  id          String      @id @default(cuid())
  title       String
  department  String?
  location    String?
  type        String      @default("full_time")
  status      String      @default("open") // open | paused | closed
  description String?
  openings    Int         @default(1)
  postedAt    DateTime    @default(now())
  candidates  Candidate[]
}

model Candidate {
  id           String   @id @default(cuid())
  jobPostingId String
  name         String
  email        String?
  phone        String?
  cvUrl        String?
  cvText       String? // extracted text for AI scoring
  stage        String   @default("applied") // applied | interviewing | offer | hired | rejected
  aiScore      Int? // 0..100
  skillsMatch  Int? // 0..100
  notes        String?
  appliedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
}

// ============================================================ Onboarding / Offboarding

model OnboardingTemplate {
  id          String              @id @default(cuid())
  title       String
  description String?
  tasks       String              @default("[]") // JSON array of {title, dayOffset}
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  processes   OnboardingProcess[]
}

model OnboardingProcess {
  id          String    @id @default(cuid())
  employeeId  String
  templateId  String?
  status      String    @default("in_progress") // in_progress | completed | cancelled
  progress    Int       @default(0) // 0..100
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  tasks       String    @default("[]") // JSON [{title, done}]

  employee Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template OnboardingTemplate? @relation(fields: [templateId], references: [id])
}

model OffboardingProcess {
  id          String    @id @default(cuid())
  employeeId  String
  lastDay     DateTime
  reason      String?
  status      String    @default("in_progress") // in_progress | completed | cancelled
  checklist   String    @default("[]") // JSON [{title, done}]
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ============================================================ Training

model TrainingPlatform {
  id           String   @id @default(cuid())
  name         String
  category     String   @default("technical") // technical | soft_skills | compliance | product | tools | leadership
  description  String?
  url          String?
  coursesCount Int      @default(0)
  logoColor    String   @default("#3b82f6")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// ============================================================ Compliance

model ComplianceAlert {
  id         String    @id @default(cuid())
  employeeId String?
  documentId String?
  severity   String    @default("medium") // critical | high | medium | low
  type       String    @default("document_expiry")
  title      String
  message    String
  status     String    @default("active") // active | resolved | dismissed
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  employee Employee? @relation(fields: [employeeId], references: [id])
}

model HRLetter {
  id         String    @id @default(cuid())
  employeeId String
  type       String    @default("employment") // employment | salary | bank | noc | experience
  status     String    @default("pending") // pending | issued | rejected
  reason     String?
  issuedAt   DateTime?
  createdAt  DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ============================================================ Surveys

model Survey {
  id          String           @id @default(cuid())
  title       String
  description String?
  status      String           @default("draft") // draft | active | closed
  questions   String           @default("[]") // JSON [{id, text, type}]
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime         @default(now())
  responses   SurveyResponse[]
}

model SurveyResponse {
  id          String   @id @default(cuid())
  surveyId    String
  employeeId  String
  answers     String   @default("[]") // JSON [{questionId, answer}]
  sentiment   Int? // -100..100
  submittedAt DateTime @default(now())

  survey   Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])
}

// ============================================================ Performance

model Goal {
  id          String    @id @default(cuid())
  employeeId  String
  createdById String?
  title       String
  description String?
  category    String    @default("performance") // performance | development | okr | kpi
  targetValue Int?
  progress    Int       @default(0) // 0..100
  status      String    @default("on_track") // on_track | at_risk | behind | completed
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("GoalCreator", fields: [createdById], references: [id])
}

model ReviewCycle {
  id          String    @id @default(cuid())
  name        String
  type        String    @default("annual") // annual | quarterly | probation | 360
  status      String    @default("not_started") // not_started | in_progress | completed
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime  @default(now())
  reviews     Review[]
}

model Review {
  id            String    @id @default(cuid())
  cycleId       String
  employeeId    String
  reviewerId    String
  status        String    @default("not_started") // not_started | in_progress | completed
  overallRating Int? // 1..5
  strengths     String?
  improvements  String?
  comments      String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  cycle    ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer Employee    @relation("Reviewer", fields: [reviewerId], references: [id])
}

model Evaluation {
  id         String   @id @default(cuid())
  employeeId String
  type       String   @default("360") // 360 | appraisal | self | peer
  ratings    String   @default("{}") // JSON {competency: score}
  feedback   String?
  aiSummary  String?
  status     String   @default("draft") // draft | submitted | acknowledged
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ============================================================ Assets

model Asset {
  id             String    @id @default(cuid())
  name           String
  type           String    @default("laptop") // laptop | phone | monitor | furniture | vehicle | other
  serialNumber   String?
  assignedToId   String?
  status         String    @default("available") // available | assigned | repair | retired
  purchaseDate   DateTime?
  warrantyExpiry DateTime?
  value          Int       @default(0) // minor units
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignedTo Employee? @relation(fields: [assignedToId], references: [id])
}

// ============================================================ Staff Requests

model StaffRequest {
  id          String   @id @default(cuid())
  userId      String
  category    String   @default("general") // general | it | hr | facilities | finance | admin
  title       String
  description String?
  priority    String   @default("medium") // low | medium | high | urgent
  status      String   @default("pending") // pending | in_progress | resolved | rejected
  response    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ============================================================ Communications

model Post {
  id        String   @id @default(cuid())
  userId    String
  content   String
  audience  String   @default("all") // all | department | managers
  mediaUrl  String?
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Announcement {
  id          String   @id @default(cuid())
  authorId    String
  title       String
  content     String
  priority    String   @default("normal") // normal | high | urgent
  publishedAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("info") // info | approval | rejection | assignment | announcement
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Conversation {
  id            String    @id @default(cuid())
  participants  String    @default("[]") // JSON user ids
  title         String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  messages      Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  sentAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])
}

model CommunicationLog {
  id         String   @id @default(cuid())
  channel    String   @default("email") // email | sms | whatsapp
  recipients String // JSON array
  subject    String?
  body       String
  status     String   @default("sent") // sent | failed
  sentAt     DateTime @default(now())
}

// ============================================================ AI

model AIChat {
  id        String      @id @default(cuid())
  userId    String
  title     String      @default("New Chat")
  createdAt DateTime    @default(now())
  messages  AIMessage[]

  user User @relation(fields: [userId], references: [id])
}

model AIMessage {
  id        String   @id @default(cuid())
  chatId    String
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())

  chat AIChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

// ============================================================ Workflow

model Workflow {
  id         String              @id @default(cuid())
  name       String
  module     String              @default("general") // leave | expense | recruitment | general
  trigger    String              @default("manual") // manual | on_create | on_status_change | scheduled
  conditions String              @default("[]")
  actions    String              @default("[]")
  active     Boolean             @default(false)
  executions Int                 @default(0)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  runs       WorkflowExecution[]
}

model WorkflowExecution {
  id          String    @id @default(cuid())
  workflowId  String
  status      String    @default("success") // success | failed | skipped
  detail      String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

// ============================================================ Tasks & Projects

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("backlog") // backlog | todo | in_progress | review | done
  assignee    String?
  priority    String    @default("medium") // low | medium | high | urgent
  dueDate     DateTime?
  projectId   String?
  createdAt   DateTime  @default(now())
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  progress    Int       @default(0) // 0..100
  createdAt   DateTime  @default(now())
}

// ============================================================ Preferences / Audit / Security

model NotificationPreference {
  id            String  @id @default(cuid())
  userId        String  @unique
  emailEnabled  Boolean @default(true)
  inAppEnabled  Boolean @default(true)
  approvals     Boolean @default(true)
  rejections    Boolean @default(true)
  assignments   Boolean @default(true)
  announcements Boolean @default(true)

  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  detail    String? // JSON before/after digest
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model SecuritySettings {
  id               String   @id @default(cuid())
  twoFactorAuth    Boolean  @default(false)
  auditLogging     Boolean  @default(true)
  dataEncryption   Boolean  @default(true)
  automatedBackups Boolean  @default(true)
  gdprCompliance   Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}
